# Copy to .env and fill in. .env is gitignored; this file is not.

# Postgres connection string.
#   Neon:  postgresql://user:password@host.neon.tech/dbname?sslmode=require
#   Local: postgresql://postgres:password@localhost:5432/mv
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Driver is inferred from the URL (neon.tech -> Neon HTTP, anything else ->
# node-postgres). Only set this to force one: neon | pg | pglite
#
# pglite is real Postgres compiled to WASM, running in this process and needing
# no DATABASE_URL. The test suite uses it; it is not for production.
# DB_DRIVER=pg

# Auth
JWT_SECRET=replace-with-a-long-random-string
# Also sets the cookie lifetime. Short, because there is no revocation.
JWT_EXPIRES_IN=1d

# TMDB — the v4 "API Read Access Token" (long, JWT-looking), NOT the short v3 key.
# themoviedb.org → Settings → API
TMDB_ACCESS_TOKEN=

# Kindle deals RSS (M0 price poller). COMMA-SEPARATED — poll as many as you
# like; results are merged and deduped by (ASIN, day), keeping the lowest price
# when feeds disagree. Amazon publishes no official feed, so coverage comes
# from aggregators and more of them is strictly better.
#   KINDLE_RSS_URL=https://feed-a/rss,https://feed-b/rss
KINDLE_RSS_URL=

# Google Books. Free key: console.cloud.google.com -> enable "Books API" ->
# Credentials -> API key (public data). Restrict it to the Books API.
GOOGLE_BOOKS_API_KEY=

# Volumes the daily poller watches, comma-separated Google Books volume ids.
# Google has no deals endpoint: prices are polled per volume and drops found by
# comparing against the previous day's row, so the history only exists because
# we polled for it (SPEC 7). Replace this seed list with genuinely tracked
# books once books are trackable in M6.
GOOGLE_BOOKS_WATCH_IDS=

# Server
PORT=5001
NODE_ENV=development

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
