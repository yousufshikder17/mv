# Copy to .env and fill in. .env is gitignored; this file is not.

# Postgres connection string.
#   Neon:  postgresql://user:password@host.neon.tech/dbname?sslmode=require
#   Local: postgresql://postgres:password@localhost:5432/mv
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Driver is inferred from the URL (neon.tech -> Neon HTTP, anything else ->
# node-postgres). Only set this to force one: neon | pg | pglite
#
# pglite is real Postgres compiled to WASM, running in this process and needing
# no DATABASE_URL. The test suite uses it; it is not for production.
# DB_DRIVER=pg

# Auth
JWT_SECRET=replace-with-a-long-random-string
# Also sets the cookie lifetime. Short, because there is no revocation.
JWT_EXPIRES_IN=1d

# TMDB — the v4 "API Read Access Token" (long, JWT-looking), NOT the short v3 key.
# themoviedb.org → Settings → API
TMDB_ACCESS_TOKEN=

# Kindle deals RSS (M0 price poller). COMMA-SEPARATED — poll as many as you
# like; results are merged and deduped by (ASIN, day), keeping the lowest price
# when feeds disagree. Amazon publishes no official feed, so coverage comes
# from aggregators and more of them is strictly better.
#   KINDLE_RSS_URL=https://feed-a/rss,https://feed-b/rss
KINDLE_RSS_URL=

# Google Books. Free key: console.cloud.google.com -> enable "Books API" ->
# Credentials -> API key (public data). Restrict it to the Books API.
GOOGLE_BOOKS_API_KEY=

# Volumes the daily poller watches, comma-separated Google Books volume ids.
# Google has no deals endpoint: prices are polled per volume and drops found by
# comparing against the previous day's row, so the history only exists because
# we polled for it (SPEC 7). Replace this seed list with genuinely tracked
# books once books are trackable in M6.
GOOGLE_BOOKS_WATCH_IDS=

# Comma-separated origins allowed to call this API. Defaults to the Vite dev
# server; set this to the deployed frontend's URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public (unauthenticated) rate limit, for the TMDB proxy routes. Must stay
# tighter than RATE_LIMIT_* over the SAME window, or the global limiter binds
# first and this does nothing.
PUBLIC_RATE_LIMIT_WINDOW_MINUTES=5
PUBLIC_RATE_LIMIT_MAX_REQUESTS=25

# RAWG (games metadata, M4). Free key: rawg.io/apidocs -> sign in -> Get API key.
#
# Sent as a ?key= query parameter, not a Bearer header - unlike TMDB. That is
# also why it must never reach the browser: a key in a URL ends up in logs,
# referrers and browser history, so RAWG is proxied through this server the
# same way TMDB is.
#
# 20,000 requests/month, about 650/day, so metadata is cached and refreshed on
# a schedule rather than fetched per page view. Their terms also require RAWG
# credited with an active hyperlink on EVERY page that displays their data.
RAWG_API_KEY=

# IsThereAnyDeal (game prices, M5). Free key: isthereanydeal.com/apps/new/
#
# Primary games price adapter (SPEC 3). Their terms require caching outright -
# "you should not be constantly maxing out your usage, implement proper
# caching" - and working around a rate limit causes a ban, so the 429 +
# Retry-After handling is compliance, not politeness.
#
# ITAD SERVES history (historyLow: overall, 1-year, 3-month, per-store), so
# game price history must be queried and cached, never accumulated. SPEC 12
# forbids building any replacement for them. Books are the opposite case -
# nothing serves that, so we poll for it.
ITAD_API_KEY=

# Web Push. Generate your own with `npx web-push generate-vapid-keys` - these
# are self-signed keys, so this channel needs no third-party account at all.
# The public key is served to the browser; the private one never leaves here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Resend (alert emails). Free tier is 3,000/month. Without a verified domain
# Resend delivers only to your own address, which is enough to test the path.
RESEND_API_KEY=
ALERT_FROM_EMAIL=onboarding@resend.dev

# MusicBrainz (album metadata, M6). NO KEY REQUIRED - the only requirement is
# a User-Agent naming the app with contact details, which defaults sensibly
# below. They block clients that omit it, and enforce one request per second.
#
# Chosen over Spotify deliberately. Spotify began requiring a Premium
# subscription to register a developer app in Feb 2026, and its terms forbid
# their content being used in recommendations or ML - so music could never
# have entered the recs pipeline. MusicBrainz core data is CC0, which is
# exactly what SPEC 3 anticipated: music is excluded from recs "until
# MusicBrainz replaces Spotify as the metadata source".
# MUSICBRAINZ_USER_AGENT=MediaVault/0.1 (+https://github.com/you/mv)

# Open Library (book metadata) - same story, no key, identify yourself.
# OPENLIBRARY_USER_AGENT=MediaVault/0.1 (you@example.com)

# Server
PORT=5001
NODE_ENV=development

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
