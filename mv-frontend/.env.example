# Where the API lives. Baked in at build time by Vite.
#
# Leave EMPTY when the backend serves the built SPA from its own origin, which
# is what mv-backend/src/middleware/spa.js does - relative URLs are correct
# there and an absolute one would point at the wrong host.
#
# Set it to the API's origin when the frontend is deployed separately, e.g.
# VITE_API_URL=https://api.example.com
VITE_API_URL=http://localhost:5001
